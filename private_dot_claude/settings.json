{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "beads@beads-marketplace": true,
    "kotlin-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true
}
